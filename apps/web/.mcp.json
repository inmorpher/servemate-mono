{
	"mcpServers": {
		"servemate": {
			"type": "local",
			"command": "ssh",
			"args": [
				"inmo@192.168.2.80",
				"bash -lc 'cd /home/inmo/ServeMate-service && exec docker compose exec -T mcp npm run mcp'"
			],
			"tools": [
				"*"
			]
		},
		"shadcn": {
			"type": "local",
			"command": "npx",
			"args": [
				"shadcn@latest",
				"mcp"
			],
			"tools": [
				"*"
			]
		}
	}
}
