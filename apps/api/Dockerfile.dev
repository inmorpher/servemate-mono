FROM node:24.19.0-trixie-slim

RUN npm install -g pnpm@11.1.2

# Build context is the monorepo root (see apps/api/docker-compose.dev.yml)
WORKDIR /app

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY packages/dto ./packages/dto
COPY apps/api/package.json ./apps/api/

RUN pnpm install --filter servemate-service...

COPY apps/api ./apps/api

RUN pnpm --filter @servemate/shared-dto build \
	&& pnpm --filter servemate-service exec prisma generate

WORKDIR /app/apps/api

EXPOSE 3000

CMD ["pnpm", "run", "dev"]
